# Copy this file to .env and fill in the values.
# Only EXPO_PUBLIC_* variables are exposed to the app (inlined at build time):
# after changing one, restart Metro with `pnpm dev --clear`.

# Google Sign-In (Google Cloud Console > APIs & Services > Credentials)
# OAuth "Web application" client ID: must be the same value as GOOGLE_CLIENT_ID in the backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# OAuth "iOS" client ID (bundle ID com.studafly.mobile).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Optional: API URL. By default the app targets the computer running Metro (http://<IP>:8080/api/v1).
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
